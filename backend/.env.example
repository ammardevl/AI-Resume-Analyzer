# Server
PORT=4000

# Comma-separated list of allowed frontend origins (Netlify URL, localhost, etc.)
FRONTEND_URL=http://localhost:5173

# Long, random secret used to sign auth JWTs. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# Optional but recommended — without it, resumes are scored with a
# lightweight offline heuristic instead of real AI feedback.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Where uploaded PDFs/images and the JSON database are stored.
# On Render, point these at a mounted persistent disk, e.g. /data/uploads
# and /data/db — the defaults below are fine for local development.
UPLOAD_DIR=./uploads
DATA_DIR=./data
